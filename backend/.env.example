# ============================================================
# HawkAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains live credentials.
# ============================================================

# ---- Google AI Studio API Key (REQUIRED) ----
# Get yours at: https://aistudio.google.com/apikey
# Paid tier required — free tier does not support live Search grounding.
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# ---- Agent model (fast, live Google Search + tool calling) ----
GEMINI_MODEL=gemini-2.5-flash

# ---- Synthesis model (signal classification + report generation) ----
SYNTHESIS_MODEL=gemini-2.5-pro

# ---- Embedding model (768-dim — must match Atlas Vector Search index) ----
EMBEDDING_MODEL=gemini-embedding-001

# ---- MongoDB Atlas (REQUIRED) ----
# Free M0 cluster at: https://mongodb.com/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/hawkai
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/hawkai
MONGODB_DATABASE=hawkai

# ---- Local development only (docker-compose sets this automatically) ----
# MONGODB_URI=mongodb://mongodb:27017

# ---- API Settings ----
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false
DISABLE_GOOGLE_SEARCH=false
