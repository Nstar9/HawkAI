# ============================================================
# HawkAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Google AI Studio API Key (REQUIRED) ----
# Get yours free at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# ---- Gemini Model (default: gemini-2.5-pro) ----
# gemini-2.5-pro   = best reasoning, use for demo
# gemini-2.5-flash = faster/cheaper, use for testing
GEMINI_MODEL=gemini-2.5-pro

# ---- Embedding Model ----
# text-embedding-004 produces 768-dimensional vectors
# Your Atlas Vector Search index MUST use numDimensions: 768
EMBEDDING_MODEL=text-embedding-004

# ---- Vertex AI (optional — leave false for AI Studio API key) ----
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---- MongoDB Atlas (REQUIRED for production) ----
# Format: mongodb+srv://username:password@cluster.mongodb.net/hawkai
# Get free M0 cluster at: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/hawkai
MONGODB_DATABASE=hawkai

# ---- Local development (docker-compose sets this automatically) ----
# MONGODB_URI=mongodb://mongodb:27017

# ---- MongoDB MCP Server ----
MCP_READ_ONLY=false

# ---- API Settings ----
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false
